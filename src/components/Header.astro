---
import { publishedCases } from '../cases'
import type { Lang } from '../consts'
import { localizePath, useTranslations } from '../i18n/utils'
import LangToggle from './LangToggle.astro'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  lang: Lang
  path: string
}

const { lang, path } = Astro.props
const t = useTranslations(lang)
const home = localizePath('/', lang)

// "Casos" sólo aparece cuando hay alguno publicado: un enlace del menú que
// lleva a una sección que no existe es peor que no tener el enlace.
const hasCases = (await publishedCases(lang)).length > 0

/**
 * Los identificadores de las anclas son los mismos en los dos idiomas a
 * propósito: así, al cambiar de idioma desde "Precios", caes en "Pricing"
 * y no arriba del todo.
 */
const links = [
  { href: `${home}#services`, label: t.nav.services },
  { href: `${home}#pricing`, label: t.nav.pricing },
  ...(hasCases ? [{ href: `${home}#cases`, label: t.nav.cases }] : []),
  { href: `${home}#projects`, label: t.nav.projects },
  { href: `${home}#about`, label: t.nav.about },
  { href: `${home}#contact`, label: t.nav.contact },
]

/**
 * Las notas no son una sección de la portada: son otra página, y este enlace
 * es la única puerta. Por eso va aparte de las anclas y se ve también en móvil,
 * donde el resto del menú está en el pie.
 */
const notes = localizePath('/notas/', lang)
const inNotes = path.startsWith('/notas')
---

<header
  class="site-header sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70"
>
  <div class="shell flex h-16 items-center justify-between gap-4">
    <a
      href={home}
      class="text-base font-semibold tracking-tight transition-colors hover:text-accent"
    >
      migue<span class="text-accent">sco</span>
    </a>

    {/* Con siete enlaces el menú ya no cabe en una tablet en vertical: las
        anclas aparecen desde `lg`, y por debajo están en el pie. «Notas» se
        queda siempre, pegado a los botones de la derecha. */}
    <nav aria-label={t.a11y.mainNav} class="ml-auto lg:ml-0">
      <ul class="flex items-center gap-6 text-sm">
        {
          links.map((link) => (
            <li class="hidden lg:block">
              <a
                href={link.href}
                class="text-muted transition-colors hover:text-accent"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="lg:border-l lg:border-line lg:pl-6">
          <a
            href={notes}
            aria-current={inNotes ? 'page' : undefined}
            class:list={[
              'transition-colors hover:text-accent',
              inNotes ? 'text-ink' : 'text-muted',
            ]}
          >
            {t.nav.notes}
          </a>
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <LangToggle lang={lang} path={path} label={t.a11y.toggleLanguage} />
      <ThemeToggle label={t.a11y.toggleTheme} />
    </div>
  </div>
</header>
