---
import { LOCALE_TAG, type Lang } from '../consts'
import { LANG_LABEL, OTHER_LANG, localizePath } from '../i18n/utils'
import Icon from './Icon.astro'

interface Props {
  lang: Lang
  /** Ruta sin prefijo de idioma, para saber a qué equivalente saltar. */
  path: string
  label: string
}

const { lang, path, label } = Astro.props
const other = OTHER_LANG[lang]
---

{/* Un enlace de verdad, no un botón con JavaScript: funciona sin JS y Google lo sigue. */}
<a
  href={localizePath(path, other)}
  hreflang={LOCALE_TAG[other]}
  data-lang-toggle
  aria-label={label}
  title={label}
  class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-line px-2.5 text-xs font-semibold text-muted transition-colors hover:border-accent hover:text-accent"
>
  <Icon name="globe" class="size-4" />
  {LANG_LABEL[other]}
</a>

<script>
  /**
   * Si estabas leyendo "Precios", al cambiar de idioma sigues en "Pricing".
   *
   * La sección se deduce de la posición real del scroll, no del hash de la URL:
   * el hash se queda pegado en la barra de direcciones después de pulsar el menú
   * y ya no dice dónde estás. Leyéndolo, alguien que pulsara "Contacto" y luego
   * subiera a mano acababa en el pie de página al cambiar de idioma.
   */
  const MARKER_RATIO = 0.35

  function visibleSectionId(): string {
    const marker = window.innerHeight * MARKER_RATIO
    for (const section of document.querySelectorAll<HTMLElement>('main section[id]')) {
      const { top, bottom } = section.getBoundingClientRect()
      if (top <= marker && bottom > marker) return section.id
    }
    // Nada bajo el marcador: estás en la portada. El enlace ya lleva arriba.
    return ''
  }

  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-lang-toggle]')) {
    link.addEventListener('click', (event) => {
      // Ctrl/⌘/rueda: es una petición de abrir en otra pestaña. No la robamos.
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) {
        return
      }
      const id = visibleSectionId()
      if (!id) return
      event.preventDefault()
      window.location.href = `${link.pathname}#${id}`
    })
  }
</script>
