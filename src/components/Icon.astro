---
import { ICON_PATHS, type IconName } from '../icons'

interface Props {
  name: IconName
  class?: string
}

const { name, class: className = 'size-5' } = Astro.props
---

{/* Decorativo siempre: el significado vive en el texto de al lado. */}
<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <Fragment set:html={ICON_PATHS[name]} />
</svg>
