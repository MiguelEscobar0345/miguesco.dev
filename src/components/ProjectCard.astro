---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

import type { Project } from '../projects'
import type { ProjectStrings } from '../i18n/types'
import BrandIcon from './BrandIcon.astro'
import Button from './Button.astro'
import Icon from './Icon.astro'

interface Props {
  project: Project
  copy: ProjectStrings
  image: ImageMetadata
  labels: { demo: string; code: string; newTab: string }
}

const { project, copy, image, labels } = Astro.props
---

<article class="flex flex-col overflow-hidden rounded-xl border border-line bg-bg">
  {/*
    La captura no es un enlace: los dos botones de abajo ya llevan a la demo y
    al código, y un tercer enlace al mismo sitio sólo estorba a quien navega
    con teclado o lector de pantalla.

    `Image` exige `alt` en tiempo de compilación y escribe width y height en el
    HTML, así que la reserva de espacio la hace el navegador y el CLS es 0.
  */}
  <Image
    src={image}
    alt={copy.imageAlt}
    widths={[480, 768, 1024]}
    sizes="(min-width: 1024px) 32rem, (min-width: 640px) 90vw, 100vw"
    loading="lazy"
    decoding="async"
    class="aspect-16/10 w-full border-b border-line bg-bg-subtle object-cover object-top"
  />

  <div class="flex flex-1 flex-col p-6 sm:p-8">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h3 class="text-xl font-semibold">{copy.name}</h3>
      <p class="text-sm font-medium text-accent">{copy.tagline}</p>
    </div>

    <p class="mt-4 text-sm leading-relaxed text-muted">{copy.description}</p>

    <ul class="mt-6 flex flex-wrap gap-2">
      {
        project.stack.map((tech) => (
          <li class="rounded-md border border-line bg-bg-subtle px-2.5 py-1 font-mono text-xs text-muted">
            {tech}
          </li>
        ))
      }
    </ul>

    {/* mt-auto: los botones de las dos tarjetas quedan a la misma altura
        aunque una descripción sea más larga que la otra. */}
    <div class="mt-auto flex flex-wrap gap-3 pt-7">
      <Button href={project.demo} external newTabLabel={labels.newTab}>
        {labels.demo}
        <Icon name="arrow" class="size-4" />
      </Button>
      <Button href={project.code} external newTabLabel={labels.newTab} variant="secondary">
        <BrandIcon name="github" class="size-4" />
        {labels.code}
      </Button>
    </div>
  </div>
</article>
