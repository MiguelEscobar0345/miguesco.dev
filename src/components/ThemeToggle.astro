---
import Icon from './Icon.astro'

interface Props {
  label: string
}

const { label } = Astro.props
---

<button
  type="button"
  data-theme-toggle
  aria-label={label}
  title={label}
  class="inline-flex size-9 items-center justify-center rounded-lg border border-line text-muted transition-colors hover:border-accent hover:text-accent"
>
  {/* El icono muestra a dónde vas, no dónde estás. */}
  <Icon name="sun" class="hidden size-4 dark:block" />
  <Icon name="moon" class="size-4 dark:hidden" />
</button>

<script>
  const root = document.documentElement

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const isDark = root.classList.toggle('dark')
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light')
      } catch {
        // Almacenamiento bloqueado: el cambio vale para esta pestaña y ya.
      }
    })
  }
</script>
